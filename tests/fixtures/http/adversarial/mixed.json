    },
    {
      "name": "nan_reserves_string",
      "expect_ok": false,
      "payload": {"mint": "So11111111111111111111111111111111111111112", "s_lamports": "NaN", "t_units": 766428571}
    },
    {
      "name": "float_reserves",
      "expect_ok": false,
      "payload": {"mint": "So11111111111111111111111111111111111111112", "s_lamports": 42.5, "t_units": 766428571}
    },
    {
      "name": "missing_mint",
      "expect_ok": false,
      "payload": {"s_lamports": 42000000000, "t_units": 766428571}
    },
    {
      "name": "wrong_types",
      "expect_ok": false,
      "payload": {"mint": 42, "s_lamports": [1], "t_units": {"n": 2}}
    },
    {
      "name": "null_body",
