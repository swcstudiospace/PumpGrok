# Copy to .env (gitignored). Every key is read by pydantic-settings with prefix PUMPGROK_.
# Nested keys use double underscore: PUMPGROK_RISK__MAX_TRADES_PER_DAY maps to risk.max_trades_per_day.
# All values here are placeholders: this file must pass the secrets gate.

PUMPGROK_PROFILE=paper                      # dev | paper | live ; selects src/pumpgrok/config/overlays/<profile>.toml
PUMPGROK_CONFIG=                            # optional operator overlay TOML applied last; empty = none
PUMPGROK_MODE=paper                         # paper | live ; precedence CLI --mode > PUMPGROK_MODE > TOML execution.mode
PUMPGROK_VAR_DIR=./var
PUMPGROK_LOG_LEVEL=INFO
PUMPGROK_LOG_JSON=true                      # false is honoured only when PUMPGROK_PROFILE=dev
PUMPGROK_HEALTH_PORT=8080

# Data sources (public endpoints only; provider keys are sent as headers, never embedded in URLs)
PUMPGROK_DATA__REST_URL=https://frontend-api.pump.fun
PUMPGROK_DATA__WS_URL=wss://pumpportal.fun/api/data
PUMPGROK_SOLANA__RPC_URLS=https://api.mainnet-beta.solana.com
PUMPGROK_SOLANA__RPC_API_KEY=<provider-key-or-empty>

# Risk overrides (optional; overlay defaults apply when unset)
PUMPGROK_RISK__MAX_TRADES_PER_DAY=20

# Replay
PUMPGROK_REPLAY__SEED=20260101              # the one SEED name the loader allows

# Alerts (stdout + file sinks are always on)
PUMPGROK_ALERTS__TELEGRAM_BOT_TOKEN=<telegram-token-or-empty>
PUMPGROK_ALERTS__TELEGRAM_CHAT_ID=<chat-id-or-empty>
PUMPGROK_ALERTS__WEBHOOK_URL=<https-url-or-empty>

# Kill switch. PUMPGROK_KILLSWITCH is read ONCE at start; the live sources polled every
# cycle are the file var/KILLSWITCH and the alert-channel command.
PUMPGROK_KILLSWITCH=false

# Live gate (nine preconditions, ALL required for effective mode live).
PUMPGROK_LIVE_ENABLE=0
PUMPGROK_LIVE__MIN_PAPER_DAYS=14
PUMPGROK_LIVE__WALLET_ALLOWLIST=            # comma-separated PUBLIC addresses; empty = live refused
PUMPGROK_LIVE__NOTIONAL_CAP_SOL=0
PUMPGROK_LIVE__CONFIRMATION_RECORD=         # path to the HMAC-signed human confirmation JSON
PUMPGROK_LIVE__ADAPTER=                     # must name a registered adapter; none ships in this build

# FORBIDDEN: the loader refuses to start if any of these names is present in the environment,
# with or without the PUMPGROK_ prefix. The only exemption is PUMPGROK_REPLAY__SEED above.
#   PRIVATE_KEY  SECRET_KEY  SEED  MNEMONIC  PHANTOM  WALLET_SECRET
#   WALLET_PRIVATE_KEY  KEYPAIR  SOLANA_PRIVATE_KEY
