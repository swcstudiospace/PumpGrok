{
  "$description": "PumpGrok operator console design tokens v1.0.0 provisional default theme. Paper-only CLI/dashboard. No brand guide supplied; system default palette only. On-primary text #ffffff is specified in ux-spec and measured by ux_contrast against color.action.primary, not stored as a background token.",
  "color": {
    "$type": "color",
    "background": { "primary": { "$value": "#ffffff", "$type": "color" } },
    "text": {
      "default": { "$value": "#111827", "$type": "color" },
      "muted": { "$value": "#595959", "$type": "color" }
    },
    "action": {
      "primary": { "$value": "#1a56db", "$type": "color" },
      "focus": { "$value": "#1a56db", "$type": "color" }
    },
    "status": {
      "success": { "$value": "#067647", "$type": "color" },
      "danger": { "$value": "#b42318", "$type": "color" },
      "warning": { "$value": "#7a4a00", "$type": "color" }
    },
    "border": {
      "default": { "$value": "#595959", "$type": "color" }
    }
  },
  "space": {
    "$type": "dimension",
    "scale-0": { "$value": "0px" },
    "scale-1": { "$value": "4px" },
    "scale-2": { "$value": "8px" },
    "scale-3": { "$value": "12px" },
    "scale-4": { "$value": "16px" },
    "scale-6": { "$value": "24px" },
    "scale-8": { "$value": "32px" },
    "scale-10": { "$value": "40px" },
    "scale-12": { "$value": "48px" }
  },
  "size": {
    "$type": "dimension",
    "target-min": { "$value": "44px" },
    "target-small": { "$value": "24px" },
    "icon": { "$value": "24px" }
  },
  "font": {
    "$type": "fontFamily",
    "family-mono": { "$value": "ui-monospace, monospace" },
    "size-base": { "$value": "16px", "$type": "dimension" },
    "size-small": { "$value": "14px", "$type": "dimension" }
  },
  "breakpoint": {
    "$type": "dimension",
    "base": { "$value": "0px" },
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" }
  },
  "motion": {
    "$type": "duration",
    "fade": { "$value": "150ms" },
    "slide": { "$value": "200ms" },
    "max": { "$value": "300ms" }
  }
}
