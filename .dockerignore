# Build context allowlist-by-exclusion: nothing secret, stateful or dev-only reaches the image.
.git
.env
.env.*
.planning
.receipts
.github
.cursor-plugin
.claude-plugin
.grok-plugin
.gsd
.venv
.mypy_cache
.pytest_cache
.ruff_cache
vendor
var
issues
agents
ci
contracts/*
docs
hermes
prompts
prompts-assembled
rules
scripts
skills
tools
config
**/__pycache__
**/*.pyc

# tests/ is excluded except the smoke replay fixture the default CMD reads.
tests/*
!tests/fixtures
tests/fixtures/*
!tests/fixtures/replay
tests/fixtures/replay/*
!tests/fixtures/replay/smoke
!contracts/tool-rosters
